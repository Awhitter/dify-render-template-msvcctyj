# No Apply-time secrets required for this Blueprint.
# Configure LLM providers in the Dify UI after first login.
#
# Wired by render.yaml (do not set manually on first deploy):
# SECRET_KEY, DATABASE_URL, DB_*, REDIS_*, CELERY_BROKER_URL, PGVECTOR_*,
# CONSOLE_*_URL, APP_*_URL, FILES_URL, STORAGE / OPENDAL_*
#
# NEXT_PUBLIC_ENABLE_AGENT_V2=false keeps the optional Agent V2 runtime hidden;
# this core Blueprint does not provision its companion services.
